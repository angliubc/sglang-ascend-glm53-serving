+
+class _NoProxyBufferingMiddleware:
+    """0909: emit X-Accel-Buffering: no so reverse proxies (nginx) stop
+    buffering SSE streams. Without it the upstream gateway drip-feeds streams at
+    ~1/8 of direct throughput (24-way: 96 vs 838 tok/s)."""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def send_wrapper(message):
+            if message["type"] == "http.response.start":
+                message.setdefault("headers", []).append(
+                    (b"x-accel-buffering", b"no")
+                )
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+
+app.add_middleware(_NoProxyBufferingMiddleware)
+
