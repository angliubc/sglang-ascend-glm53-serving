+    def _compact_grouped_matmul(
+        self,
+        quant_info,
+        weight_prefix: str,
+        hidden_states: torch.Tensor,
+        expert_tokens: torch.Tensor,
+        pertoken_scale: torch.Tensor,
+        scale: torch.Tensor,
+        output_dtype: torch.dtype,
+    ) -> torch.Tensor:
+        """Grouped matmul over only the ACTIVE experts (0910, v2 permutation-free).
+
+        npu_grouped_matmul reads the weights of every group in the weight
+        tensor it is given, empty or not (microbench 0910: int32-packed int4 +
+        packed scale costs a full weight read at ~440GB/s — 288-expert tensor
+        ≈0.7-1.7ms per call, 84 calls per decode step). This path gathers at
+        most min(T, E) experts into a compact tensor and runs the GMM against
+        that instead.
+
+        The selected experts are kept in ASCENDING expert-id order. Rows
+        arrive expert-sorted and every row belongs to a nonzero-count expert,
+        so dropping the empty experts leaves the row layout untouched: the
+        activations feed the GMM unpermuted and its output is returned as-is.
+        Zero-count padding experts at the tail of the selection keep every
+        shape static for graph capture.
+
+        Requires W4A8_SKIP_NZ=1 (ND-format weights are dim-0 indexable) and
+        W4A8_DROP_SCALE_BIAS=1 (no bias args). CPU logic test: 30/30 PASS
+        (/tmp/test_compact2.py).
+        """
+        weight = getattr(quant_info, f"{weight_prefix}_weight")
+        num_tokens = hidden_states.shape[0]
+        num_experts = expert_tokens.shape[0]
+        num_active = min(num_tokens, num_experts)
+
+        # Every expert with a nonzero token count is guaranteed to be included
+        # (distinct active experts <= num_tokens); the tail is zero-count
+        # padding, harmless to the GMM.
+        idx = torch.sort(torch.topk(expert_tokens, num_active).indices).values
+        cnt = expert_tokens.index_select(0, idx)
+
+        return torch.ops.npu.npu_grouped_matmul(
+            x=[hidden_states],
+            weight=[weight.index_select(0, idx)],
+            scale=[scale.index_select(0, idx)],
+            per_token_scale=[pertoken_scale],
+            split_item=2,
+            group_list_type=1,
+            group_type=0,
+            group_list=cnt,
+            output_dtype=output_dtype,
+        )[0]
+
 
