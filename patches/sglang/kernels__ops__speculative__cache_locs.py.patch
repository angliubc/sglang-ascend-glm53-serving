+                req_pool_indices[bad][:8].tolist(),
+                start_offset[bad][:8].tolist(),
+                end_offset[bad][:8].tolist(),
+            )
+            req_pool_indices = req_pool_indices.clamp(0, max_reqs - 1)
+            start_offset = start_offset.clamp(0, pool_len - 1)
