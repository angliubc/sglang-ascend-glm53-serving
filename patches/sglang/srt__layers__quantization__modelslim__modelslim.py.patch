+    def _is_extra_layer_beyond_quant_set(self, prefix: str) -> bool:
+        """True if prefix's layer index exceeds every layers.N.* entry in the
+        quant description -- i.e. an appended layer (MTP/nextn) the quantizer
+        never covered. 0904."""
+        m = re.search(r"layers\.(\d+)\.", prefix)
+        if not m:
+            return False
+        idx = int(m.group(1))
+        mx = getattr(self, "_desc_max_layer", None)
+        if mx is None:
+            mx = -1
+            for k in self.quant_description:
+                km = re.search(r"layers\.(\d+)\.", k)
+                if km:
+                    mx = max(mx, int(km.group(1)))
+            self._desc_max_layer = mx
+        return mx >= 0 and idx > mx
