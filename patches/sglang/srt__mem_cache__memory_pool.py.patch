+    def _c8_buf_idx(self, buf_idx: int) -> int:
+        """Map a global layer slot to a dense c8 buffer index (identity when
+        W4A8_C8_DENSE is off)."""
+        m = getattr(self, "c8_dense_map", None)
+        if m is None:
+            return buf_idx
+        if buf_idx not in m:
+            raise RuntimeError(f"layer slot {buf_idx} has no dense c8 KV buffer")
+        return m[buf_idx]
+
+    def _set_kv_buffer_c8(self, buf_idx: int, loc: torch.Tensor, cache_k: torch.Tensor):
+        """W4A8_C8_KV: quantize the DSA latent to per-token per-128ch-group
+        symmetric int8 and write a 656B combine-mode row (inline bf16 k/v
+        scales; rope region kept zero for NoPE)."""
+        k = cache_k.view(-1, 1, self.kv_lora_rank).float()
+        ng = self.c8_num_groups
+        kg = k.view(-1, ng, 128)
+        amax = kg.abs().amax(dim=-1, keepdim=True).clamp(min=1e-6)
+        # quantize against the bf16-rounded scale the kernel will dequant with
+        s = (amax / 127.0).to(torch.bfloat16).float()  # [T, ng, 1]
+        kq = (kg / s).round().clamp(-127, 127).to(torch.int8).view(
+            -1, 1, self.kv_lora_rank
+        )
+        row = kq.new_zeros(kq.shape[0], 1, self.c8_row_dim)
+        row[:, :, : self.kv_lora_rank] = kq
+        rb = row.view(torch.bfloat16)  # [T, 1, 328]; slot = byte // 2
+        base = (self.kv_lora_rank + 128) // 2  # 320 -> scale bytes at 640
+        s_bf = s.squeeze(-1).to(torch.bfloat16)
+        for gi in range(ng):
+            rb[:, 0, base + 2 * gi] = s_bf[:, gi]  # k_scale
+            rb[:, 0, base + 2 * gi + 1] = s_bf[:, gi]  # v_scale (sharedkv)
+        self.kv_buffer[buf_idx][loc] = row
+
+    def get_c8_kv_pool(self, layer_id: int) -> torch.Tensor:
+        """Paged int8 KV pool view [pages, page, 1, 656] (PA_BSND) for
+        npu_kv_quant_sparse_flash_attention."""
+        if self.layer_transfer_counter is not None:
+            self.layer_transfer_counter.wait_until(layer_id - self.start_layer)
+        buf = self.kv_buffer[self._c8_buf_idx(layer_id - self.start_layer)]
+        num_pages = buf.shape[0] // self.page_size
+        return buf[: num_pages * self.page_size].view(
+            num_pages, self.page_size, 1, self.c8_row_dim
+        )
